SECRET_TOKEN=CHANGE_ME_LONG_RANDOM
DATA_FILE=/var/lib/observatory_presence/presence.json
SESSION_LOG_FILE=/var/lib/observatory_presence/session_log.json
SESSION_LOG_DEFAULT_LIMIT=100
HEARTBEAT_TIMEOUT=90
BASE_PATH=/ost_status
# Do not set in production (local dev only):
# ALLOW_OPEN_API=1
# Camera JPG/WebM files (Apache serves in production; Flask fallback for local dev)
# CAMERA_MEDIA_DIR=/var/lib/observatory_cameras
# Stale monitoring entry TTL (seconds)
# HOST_STATUS_TTL_SEC=3600
# TELESCOPE_STATUS_TTL_SEC=2400

# ---------------------------------------------------------------------------
# Dashboard login (LDAP)
#
# Browsers log in here; the agents keep using SECRET_TOKEN above. The app
# refuses to start without SESSION_SECRET and LDAP_SERVER_URI.
# ---------------------------------------------------------------------------

# Signs the login cookie. Generate once and keep it stable -- changing it logs
# everyone out. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM

# Prefer ldaps://. Plain ldap:// without LDAP_START_TLS=1 is refused at startup
# because user passwords would travel unencrypted.
LDAP_SERVER_URI=ldaps://ldap.example.org
LDAP_START_TLS=1
# CA file, if the directory certificate is not signed by a system-trusted CA.
LDAP_TLS_CACERT=

# Service account used to look up the user entry before binding as the user.
# Leave empty for an anonymous search, if the directory allows it.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=org
# %(user)s is replaced with the (escaped) submitted username.
LDAP_USER_FILTER=(uid=%(user)s)
LDAP_CONNECT_TIMEOUT=5

# Groups whose members may open the dashboard. Several DNs are separated by
# ";" because a DN itself contains commas. Membership is accepted via memberOf,
# groupOfNames/member or posixGroup/memberUid.
# EMPTY MEANS: every valid directory account can log in.
LDAP_ALLOWED_GROUP_DNS=cn=observatory,ou=groups,dc=example,dc=org;cn=astro-staff,ou=groups,dc=example,dc=org

# Absolute session lifetime; refreshing the page does not extend it.
SESSION_LIFETIME_HOURS=12
# Failed logins per user+IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Behind the Apache reverse proxy, set this so rate limiting and logging see
# the real client IP instead of the proxy.
TRUST_PROXY_HEADERS=1

# Only for local HTTP testing -- never unset this in production:
# SESSION_COOKIE_SECURE=0
# Skips the login entirely. LOCAL DEVELOPMENT ONLY:
# ALLOW_ANONYMOUS_DASHBOARD=1
