SECRET_TOKEN=CHANGE_ME_LONG_RANDOM
DATA_FILE=/var/lib/observatory_presence/presence.json
SESSION_LOG_FILE=/var/lib/observatory_presence/session_log.json
SESSION_LOG_DEFAULT_LIMIT=100
HEARTBEAT_TIMEOUT=90
BASE_PATH=/ost_status
# Do not set in production (local dev only):
# ALLOW_OPEN_API=1
# Camera JPG/WebM files (Apache serves in production; Flask fallback for local dev)
# CAMERA_MEDIA_DIR=/var/lib/observatory_cameras
# Stale monitoring entry TTL (seconds)
# HOST_STATUS_TTL_SEC=3600
# TELESCOPE_STATUS_TTL_SEC=2400
